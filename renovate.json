{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "minimumReleaseAge": "2 days",
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "timezone": "Europe/Amsterdam",
  "labels": [
    "dependencies"
  ],
  "schedule": ["before 6am on friday"],
  "prConcurrentLimit": 10,
  "packageRules": [
    {
      "description": "Update the artifact actions together; artifacts uploaded with one major version may not be readable by another",
      "matchDepNames": ["actions/download-artifact", "actions/upload-artifact"],
      "groupName": "artifact actions"
    }
  ]
}
